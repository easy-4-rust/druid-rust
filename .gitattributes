# 验证台账与 API 快照使用规范 LF 字节，避免 Windows checkout 改变校验值。
*.tsv text eol=lf
/api/*.txt text eol=lf
/docs/verification/**/*.json text eol=lf

# Preserve archived evidence byte hashes while publishing plain files.
/docs/verification/rdbc-first/preflight404/** -text whitespace=cr-at-eol
/docs/verification/rdbc-first/workspace405/** -text whitespace=cr-at-eol
/docs/verification/rdbc-first/workspace405/*.log -text whitespace=cr-at-eol,-blank-at-eof
