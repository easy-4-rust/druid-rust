251	    fn check_delete_statement(&self, delete: &sqlparser::ast::Delete, v: &mut Vec<WallViolation>) {
252	        if !self.config.delete_allow {
253	            v.push(WallViolation::OperationNotAllowed("DELETE".to_owned()));
254	        }
255	        if delete.selection.is_none() && self.config.delete_must_have_where {
256	            v.push(WallViolation::DeleteWithoutWhere);
257	        }
258	        if self.config.delete_where_alway_true_check
259	            && delete.selection.as_ref().is_some_and(is_always_true)
260	        {
261	            Self::push_unique(
262	                v,
263	                WallViolation::AlwaysTrueCondition("DELETE WHERE".to_owned()),
264	            );
265	        }
266	        self.check_condition_opt(delete.selection.as_ref(), v);
267	        self.check_from_table(&delete.from, v);
268	        for table_with_joins in tables_of(&delete.from) {
269	            if let TableFactor::Table { name, .. } = &table_with_joins.relation {
270	                self.check_read_only(name, v);
271	            }
272	        }
273	    }
