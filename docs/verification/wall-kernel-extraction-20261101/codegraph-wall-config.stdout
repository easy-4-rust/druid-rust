535	    fn check_object_name(&self, name: &ObjectName, v: &mut Vec<WallViolation>) {
536	        let name_str = name.to_string().to_ascii_lowercase();
537	        let segments = name_str
538	            .split('.')
539	            .map(|segment| segment.trim_matches(['`', '"', '[', ']']))
540	            .collect::<Vec<_>>();
541	        if self.config.schema_check && segments.len() > 1 {
542	            let schema = segments[..segments.len() - 1].join(".");
543	            if self
544	                .config
545	                .deny_schemas
546	                .iter()
547	                .any(|deny| schema.eq_ignore_ascii_case(deny))
548	            {
549	                Self::push_unique(v, WallViolation::DeniedSchema(schema));
550	            }
551	        }
552	        if self.config.object_check {
553	            for deny in &self.config.deny_objects {
554	                if name_str.eq_ignore_ascii_case(deny) {
555	                    Self::push_unique(v, WallViolation::DeniedObject(name_str.clone()));
556	                }
557	            }
558	        }
559	        if self.config.table_check {
560	            let table = segments.last().copied().unwrap_or(name_str.as_str());
561	            for deny in &self.config.deny_tables {
562	                if table.eq_ignore_ascii_case(deny) {
563	                    Self::push_unique(v, WallViolation::DeniedTable(name_str.clone()));
564	                }
565	            }
566	        }
567	    }
