311	                (self.config.start_transaction_allow, "START TRANSACTION")
312	            }
313	            Statement::SetVariable { .. } => (self.config.set_allow, "SET"),
314	            Statement::Use(_) => (self.config.use_allow, "USE"),
315	            Statement::Call(_) => (self.config.call_allow, "CALL"),
316	            _ => (self.config.show_allow, "SHOW"),
317	        };
318	        (!allow).then(|| WallViolation::OperationNotAllowed(name.to_owned()))
