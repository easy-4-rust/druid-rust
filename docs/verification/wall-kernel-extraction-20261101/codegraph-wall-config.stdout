575	    fn collect_wall_context_warnings(statement: &Statement) {
576	        let Some(context) = WallContext::current() else {
577	            return;
578	        };
579	        let mut context = context.lock();
580	        match statement {
581	            Statement::Update {
582	                selection: None, ..
583	            } => context.increment_update_none_condition_warnings(),
584	            Statement::Delete(delete)
585	                if delete.selection.is_none()
586	                    && delete.using.is_none()
587	                    && !from_has_join(&delete.from) =>
588	            {
589	                context.increment_delete_none_condition_warnings();
590	            }
591	            _ => {}
592	        }
593	
594	        let _: ControlFlow<()> = visit_expressions(statement, |expression| {
595	            if let Expr::Like { expr, pattern, .. } = expression {
596	                if is_number_literal(expr) || is_number_literal(pattern) {
597	                    context.increment_like_number_warnings();
598	                }
599	            }
600	            ControlFlow::Continue(())
601	        });
602	    }
603	
604	    fn collect_comment_warnings(&self, sql: &str) {
605	        let Some(context) = WallContext::current() else {
606	            return;
607	        };
608	        let dialect = SqlUtils::dialect(self.db_type());
609	        let Ok(tokens) = Tokenizer::new(dialect.as_ref(), sql).tokenize() else {
610	            return;
611	        };
612	        let mut previous = None;
613	        let mut count = 0_u32;
614	        for token in tokens {
615	            match &token {
616	                Token::Whitespace(
617	                    Whitespace::SingleLineComment { .. } | Whitespace::MultiLineComment(_),
618	                ) => {
619	                    if previous
620	                        .as_ref()
621	                        .is_some_and(|previous| !comment_is_accepted_after(previous))
622	                    {
623	                        count = count.wrapping_add(1);
624	                    }
625	                }
626	                Token::Whitespace(_) | Token::EOF => {}
627	                _ => previous = Some(token),
628	            }
629	        }
630	        let mut context = context.lock();
631	        for _ in 0..count {
632	            context.increment_comment_count();
633	        }
634	    }
